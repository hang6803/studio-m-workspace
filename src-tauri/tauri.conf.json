{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M app",
  "version": "0.8.7",
  "identifier": "my.studiom.mapp",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Studio M Workspace",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
